---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartImage from '../../components/SmartImage.astro';
import site from '../../data/site.json';
import polemarchsData from '../../data/polemarchs.json';
import { ordinal } from '../../utils/format';

const { note, polemarchs } = polemarchsData;
---
<BaseLayout
  title="Past Polemarchs"
  description={`All ${site.polemarchsCount} Polemarchs who have led the Boston (MA) Alumni Chapter of Kappa Alpha Psi since 1950.`}
>
  <section class="hero">
    <div class="container">
      <h1>Past Polemarchs</h1>
      <p class="tagline">{site.polemarchsCount} Brothers Have Led Our Chapter</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <p>{note}</p>
        <p class="legend"><span class="deceased-marker">*</span> indicates deceased</p>
      </div>

      <div class="polemarchs-grid">
        {polemarchs.map((pol: any) => (
          <div class={`polemarch-card${pol.deceased ? ' deceased' : ''}`}>
            <div class="polemarch-photo">
              <SmartImage
                src="/assets/images/branding/chapter-logo-optimized.png"
                alt="Boston Alumni Chapter"
                sizes="150px"
                widths={[150, 300]}
              />
            </div>
            <div class="polemarch-number">{ordinal(pol.number)}</div>
            <h3 class="polemarch-name">
              {pol.name}
              {pol.deceased && <span class="deceased-marker">*</span>}
            </h3>
            <p class="polemarch-term">{pol.term}</p>
            <p class="polemarch-initiation">{pol.initiatingChapter}</p>
            <p class="polemarch-date">{pol.initiationDate}</p>
            {pol.notable && <p class="polemarch-notable">{pol.notable}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="text-center" style="padding: var(--space-8) 0;">
    <a href="#top" class="back-to-top">↑ Back to Top</a>
  </div>
</BaseLayout>
