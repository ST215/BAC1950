---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import eventsData from '../../data/events.json';
import { formatDate } from '../../utils/format';

interface GalleryImage { file: string; width: number; height: number; alt: string }
interface Gallery { count: number; images: GalleryImage[] }

export function getStaticPaths() {
  return eventsData.events.map((event: any) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

let gallery: Gallery | null = null;
if (event.galleryManifest) {
  const manifestPath = join(process.cwd(), 'public', 'event-photos', event.galleryManifest, 'manifest.json');
  if (existsSync(manifestPath)) {
    gallery = JSON.parse(readFileSync(manifestPath, 'utf-8'));
  }
}
const photoBase = event.galleryManifest ? `/event-photos/${event.galleryManifest}` : '';
---
<BaseLayout
  title={event.title}
  description={`A fireside chat with Dr. Larome Myrick on his journey through American justice, hosted by the Boston (MA) Alumni Chapter of Kappa Alpha Psi.`}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <script
    slot="scripts"
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
    defer
    is:inline
  ></script>
  <script slot="scripts" src="/scripts/event-map.js" defer is:inline></script>

  <section class="hero event-hero">
    <div class="container">
      <p class="event-hero-kicker">{event.type}</p>
      <h1 class="hero-title event-hero-title" data-pretext-lines>{event.title}</h1>
      <p class="tagline event-hero-subtitle">{event.subtitle}</p>
      <p class="event-hero-meta">
        <time datetime={`${event.date}T${event.startTime}`}>{formatDate(event.date)}</time>
        &middot;
        <span>{event.startTime}&ndash;{event.endTime}</span>
        &middot;
        <span>{event.venue.name}, {event.venue.city}</span>
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="event-overview">
        <div class="event-flyer">
          <img
            src={event.flyer}
            alt={`Event flyer for ${event.title}`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="event-description">
          <h2>About the Event</h2>
          {event.description.map((para: string) => (
            <p>{para}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Featured Speaker &amp; Moderator</h2>
      </div>
      <div class="event-speaker-grid">
        {event.speakers.map((speaker: any) => (
          <article class="card event-speaker-card">
            <div class="card-content">
              <p class="event-speaker-role">{speaker.role}</p>
              <h3 class="card-title">{speaker.name}</h3>
              <p class="card-text">{speaker.bio}</p>
              {speaker.url && (
                <a href={speaker.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary mt-1 external-link">Learn More</a>
              )}
            </div>
          </article>
        ))}
        {event.moderator && (
          <article class="card event-speaker-card">
            <div class="card-content">
              <p class="event-speaker-role">{event.moderator.role}</p>
              <h3 class="card-title">{event.moderator.name}</h3>
              <p class="card-text">{event.moderator.bio}</p>
              {event.moderator.url && (
                <a href={event.moderator.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary mt-1 external-link">Learn More</a>
              )}
            </div>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Venue</h2>
      </div>
      <div class="event-venue-grid">
        <div class="event-venue-card card">
          <div class="card-content">
            <h3 class="card-title">{event.venue.name}</h3>
            <address class="event-venue-address">
              {event.venue.street}<br />
              {event.venue.city}, {event.venue.state} {event.venue.zip}
            </address>
            <a
              href={`https://www.google.com/maps/dir/?api=1&destination=${event.venue.lat},${event.venue.lng}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary mt-1 external-link"
            >Get Directions</a>
          </div>
        </div>
        <div
          id="event-map"
          class="event-map"
          data-lat={event.venue.lat}
          data-lng={event.venue.lng}
          data-venue={event.venue.name}
          data-address={`${event.venue.street}, ${event.venue.city}, ${event.venue.state}`}
          aria-label="Map showing the venue location"
        ></div>
      </div>
    </div>
  </section>

  {gallery && gallery.images.length > 0 && (
    <section class="page-section">
      <div class="container">
        <div class="section-header">
          <h2>Photo Gallery</h2>
          <p class="news-item-caption">{gallery.count} photos from the event</p>
        </div>
        <div class="event-gallery">
          {gallery.images.map((img) => (
            <figure class="event-gallery-item">
              <img
                src={`${photoBase}/${img.file}`}
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
                class="event-gallery-img enlargeable"
              />
            </figure>
          ))}
        </div>

        {event.photography && (
          <aside class="photo-credit" aria-label="Photography credit">
            <p class="photo-credit-label">Photography</p>
            <p class="photo-credit-name">{event.photography.credit}</p>
            <p class="photo-credit-gear">
              <span>{event.photography.camera}</span>
              <span class="photo-credit-sep" aria-hidden="true">&middot;</span>
              <span>{event.photography.lens}</span>
            </p>
          </aside>
        )}
      </div>
    </section>
  )}

  <div class="text-center news-back-to-top">
    <a href="/news/" class="back-to-top">&larr; Back to News</a>
  </div>
</BaseLayout>
