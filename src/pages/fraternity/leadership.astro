---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import { ordinal } from '../../utils/format';
---
<BaseLayout
  title="Grand Chapter Leadership"
  description="Current leadership of Kappa Alpha Psi Fraternity, Inc. at the national level."
>
  <section class="hero">
    <div class="container">
      <h1>Grand Chapter Leadership</h1>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>{ordinal(site.grandChapter.grandPolemarch.number)} Grand Polemarch</h2>
      </div>

      <div class="text-center">
        <h3 style="font-size: 1.5rem; margin-bottom: var(--spacing-xs);">{site.grandChapter.grandPolemarch.name}</h3>
        <p>{site.grandChapter.grandPolemarch.initiatingChapter} — {site.grandChapter.grandPolemarch.initiationYear}</p>
      </div>

      <a href="#top" class="back-to-top">↑ Back to Top</a>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Grand Chapter Officers</h2>
      </div>

      <div class="card-grid">
        {site.grandChapter.officers.map((officer: any) => (
          <div class="card profile-card">
            <h3>{officer.name}</h3>
            <p class="title">{officer.position}</p>
            {officer.initiatingChapter && officer.initiatingChapter !== "TBD" && (
              <p>{officer.initiatingChapter} — {officer.initiationYear}</p>
            )}
          </div>
        ))}
      </div>

      <a href="#top" class="back-to-top">↑ Back to Top</a>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Grand Board of Directors</h2>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg);">
        <div>
          <h4>Alumni Members</h4>
          <ul style="margin-left: var(--spacing-md);">
            {site.grandChapter.boardOfDirectors.alumni.map((member: string) => (
              <li>{member}</li>
            ))}
          </ul>
        </div>
        <div>
          <h4>Undergraduate Members</h4>
          <ul style="margin-left: var(--spacing-md);">
            {site.grandChapter.boardOfDirectors.undergraduate.map((member: string) => (
              <li>{member}</li>
            ))}
          </ul>
        </div>
      </div>

      <a href="#top" class="back-to-top">↑ Back to Top</a>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Administrative Staff</h2>
      </div>

      <div class="card-grid">
        {site.grandChapter.administrativeStaff.map((staff: any) => (
          <div class="card profile-card">
            <h3>{staff.name}</h3>
            <p class="title">{staff.position}</p>
          </div>
        ))}
      </div>

      <a href="#top" class="back-to-top">↑ Back to Top</a>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>International Headquarters</h2>
      </div>
      <div class="text-center">
        <p><strong>Kappa Alpha Psi Fraternity, Inc.</strong></p>
        <p>{site.grandChapter.headquarters.address}</p>
        <div class="mt-2">
          <a href={site.grandChapter.headquarters.website} target="_blank" rel="noopener noreferrer" class="btn btn-primary external-link">Visit Official Website</a>
        </div>
      </div>
      <a href="#top" class="back-to-top">↑ Back to Top</a>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <h2>Northeastern Province</h2>
      </div>
      <div class="text-center">
        <p>The Boston (MA) Alumni Chapter is a proud member of the <strong>{site.province.name}</strong>.</p>
        <p><strong>Province Polemarch:</strong> {site.province.polemarch.name}</p>
        <div class="mt-2">
          <a href={site.province.website} target="_blank" rel="noopener noreferrer" class="btn btn-secondary external-link">Visit Province Website</a>
        </div>
      </div>
      <a href="#top" class="back-to-top">↑ Back to Top</a>
    </div>
  </section>
</BaseLayout>
